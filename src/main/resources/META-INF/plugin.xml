<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.devvikassoni.leaklens</id>
    <name>LeakLens</name>
    <vendor email="vikasacsoni9211@gmail.com" url="https://github.com/dev-vikas-soni">Vikas Soni</vendor>

    <description><![CDATA[
        <p><b>LeakLens</b> — Professional Android Memory Leak Detection & Fix Assistant directly in your IDE.</p>

        <p>LeakLens integrates LeakCanary's Shark heap analysis engine into Android Studio, providing a seamless workflow to detect,
        understand, and fix memory leaks without context switching.</p>

        <h3>Key Features</h3>
        <ul>
            <li><b>🔍 Runtime Analysis:</b> Capture heap dumps from connected devices or import .hprof files for deep Shark-powered analysis.</li>
            <li><b>🛡️ Preventive Inspections:</b> Catch leaks <i>while you write code</i> with 6 specialized UAST inspections for Java and Kotlin.</li>
            <li><b>💡 Smart Fix Engine:</b> Get actionable fix suggestions for 11 common Android leak patterns, including code snippets.</li>
            <li><b>🤖 AI-Assisted Fixes:</b> (Optional) Use OpenAI or Google Gemini to analyze complex or novel leak traces.</li>
            <li><b>📊 Memory Monitor:</b> Real-time device memory graph with automatic heap dump triggers when thresholds are exceeded.</li>
            <li><b>🎯 One-Click Navigation:</b> Jump directly from a leak trace to the problematic line in your source code.</li>
            <li><b>📋 Team Collaboration:</b> VCS-tracked baselines to suppress known leaks and CI-ready reporting (HTML, JSON, SARIF).</li>
        </ul>

        <p>Built for modern Android development, LeakLens supports both Java and Kotlin seamlessly.</p>
    ]]></description>

    <change-notes><![CDATA[
        <h4>0.1.1</h4>
        <ul>
            <li>Migrated all inspections to UAST for robust Java and Kotlin support.</li>
            <li>Polished UI using IntelliJ UI DSL 2 for native theme integration.</li>
            <li>Improved ADB stability with dedicated timeouts and resource cleanup.</li>
            <li>Added intelligent handling and warnings for large heap dumps.</li>
            <li>Enhanced Fix Suggestion Engine with clearer headers and formatting.</li>
            <li>100% passing unit and integration test suite verified.</li>
            <li>Added professional SVG icons for tool window and marketplace.</li>
        </ul>
        <h4>0.1.0</h4>
        <ul>
            <li>Initial release of LeakLens with Shark heap analysis integration.</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.android</depends>

    <resource-bundle>messages.LeakLensBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="LeakLens"
            anchor="bottom"
            icon="/META-INF/leaklens_icon.svg"
            factoryClass="com.github.devvikassoni.leaklens.toolWindow.LeakLensToolWindowFactory"/>

        <projectService serviceImplementation="com.github.devvikassoni.leaklens.services.LeakLensProjectService"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.services.AdbHeapDumpService"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.services.SharkAnalysisService"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.services.LogcatHeapDumpListener"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.services.LeakAnalysisCoordinator"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.services.SourceNavigationService"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.settings.LeakLensSettingsState"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.ai.AiAnalysisService"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.monitoring.DeviceMemoryMonitor"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.baseline.LeakBaselineManager"/>
        <projectService serviceImplementation="com.github.devvikassoni.leaklens.deobfuscation.DeobfuscationService"/>

        <projectConfigurable
            instance="com.github.devvikassoni.leaklens.settings.LeakLensConfigurable"
            id="com.github.devvikassoni.leaklens.settings"
            displayName="LeakLens"
            parentId="tools"/>

        <codeInsight.lineMarkerProvider language="JAVA" implementationClass="com.github.devvikassoni.leaklens.gutter.LeakGutterLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin" implementationClass="com.github.devvikassoni.leaklens.gutter.LeakGutterLineMarkerProvider"/>

        <notificationGroup id="LeakLens Notifications" displayType="BALLOON"/>
        <backgroundPostStartupActivity implementation="com.github.devvikassoni.leaklens.startup.LeakLensStartupActivity"/>

        <!-- Intentions -->
        <intentionAction>
            <language>JAVA</language>
            <className>com.github.devvikassoni.leaklens.fix.AddRemoveCallbacksFixAction</className>
            <category>LeakLens</category>
        </intentionAction>
        <intentionAction>
            <language>kotlin</language>
            <className>com.github.devvikassoni.leaklens.fix.AddRemoveCallbacksFixAction</className>
            <category>LeakLens</category>
        </intentionAction>

        <intentionAction>
            <language>JAVA</language>
            <className>com.github.devvikassoni.leaklens.fix.NullBindingFixAction</className>
            <category>LeakLens</category>
        </intentionAction>
        <intentionAction>
            <language>kotlin</language>
            <className>com.github.devvikassoni.leaklens.fix.NullBindingFixAction</className>
            <category>LeakLens</category>
        </intentionAction>

        <intentionAction>
            <language>JAVA</language>
            <className>com.github.devvikassoni.leaklens.fix.UseApplicationContextFixAction</className>
            <category>LeakLens</category>
        </intentionAction>
        <intentionAction>
            <language>kotlin</language>
            <className>com.github.devvikassoni.leaklens.fix.UseApplicationContextFixAction</className>
            <category>LeakLens</category>
        </intentionAction>

        <!-- Static Analysis Inspections (UAST) -->
        <localInspection language="UAST" groupName="LeakLens" shortName="LeakLensStaticActivityReference"
            displayName="Activity/Fragment stored in static field" enabledByDefault="true" level="WARNING"
            implementationClass="com.github.devvikassoni.leaklens.inspections.StaticActivityReferenceInspection"/>
        <localInspection language="UAST" groupName="LeakLens" shortName="LeakLensAnonymousInnerClassLeak"
            displayName="Anonymous inner class may leak outer Activity/Fragment" enabledByDefault="true" level="WARNING"
            implementationClass="com.github.devvikassoni.leaklens.inspections.AnonymousInnerClassLeakInspection"/>
        <localInspection language="UAST" groupName="LeakLens" shortName="LeakLensContextPassedToSingleton"
            displayName="Activity Context passed to Singleton" enabledByDefault="true" level="WARNING"
            implementationClass="com.github.devvikassoni.leaklens.inspections.ContextPassedToSingletonInspection"/>
        <localInspection language="UAST" groupName="LeakLens" shortName="LeakLensMissingRemoveCallbacks"
            displayName="Missing removeCallbacksAndMessages in onDestroy" enabledByDefault="true" level="WARNING"
            implementationClass="com.github.devvikassoni.leaklens.inspections.MissingRemoveCallbacksInspection"/>
        <localInspection language="UAST" groupName="LeakLens" shortName="LeakLensGlobalScopeWithContext"
            displayName="GlobalScope coroutine may leak Activity/Context" enabledByDefault="true" level="WARNING"
            implementationClass="com.github.devvikassoni.leaklens.inspections.GlobalScopeWithContextInspection"/>
        <localInspection language="UAST" groupName="LeakLens" shortName="LeakLensViewReferenceHeld"
            displayName="View reference held beyond lifecycle in Fragment" enabledByDefault="true" level="WARNING"
            implementationClass="com.github.devvikassoni.leaklens.inspections.ViewReferenceHeldInspection"/>
    </extensions>

    <actions>
        <action id="LeakLens.AnalyzeCurrentFile" class="com.github.devvikassoni.leaklens.actions.AnalyzeCurrentFileAction"
                text="Analyze Current File" description="Run LeakLens static analysis on the active editor file"
                icon="AllIcons.Actions.Execute"/>
        <action id="LeakLens.AnalyzeProject" class="com.github.devvikassoni.leaklens.actions.AnalyzeProjectAction"
                text="Analyze Project" description="Run LeakLens static analysis on the entire project"
                icon="AllIcons.Actions.Resume"/>
        <action id="LeakLens.ClearAll" class="com.github.devvikassoni.leaklens.actions.ClearAllAction"
                text="Clear All" description="Clear all detected leaks and issues"
                icon="AllIcons.Actions.GC"/>
        <action id="LeakLens.MonitorMemory" class="com.github.devvikassoni.leaklens.actions.MonitorMemoryAction"
                text="Start Memory Monitor" description="Start/stop real-time device memory monitoring"
                icon="AllIcons.Actions.Profile"/>

        <group id="LeakLens.ActionGroup" text="LeakLens" description="LeakLens Actions">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="LeakLens.DumpHeap" class="com.github.devvikassoni.leaklens.actions.DumpHeapAction"
                    text="Dump Heap Now" description="Capture a heap dump from the connected device and analyze it"
                    icon="AllIcons.Actions.Download"/>
            <action id="LeakLens.ImportHprof" class="com.github.devvikassoni.leaklens.actions.ImportHprofAction"
                    text="Import .hprof File" description="Import and analyze a local .hprof heap dump file"
                    icon="AllIcons.ToolbarDecorator.Import"/>
            <action id="LeakLens.ToggleAutoDetect" class="com.github.devvikassoni.leaklens.actions.ToggleAutoDetectAction"
                text="Start Auto-Detect" description="Toggle automatic detection of LeakCanary heap dumps via logcat"/>
            <separator/>
            <action id="LeakLens.MonitorMemory" class="com.github.devvikassoni.leaklens.actions.MonitorMemoryAction"
                text="Start Memory Monitor" description="Start/stop real-time device memory monitoring"/>
            <action id="LeakLens.ExportReport" class="com.github.devvikassoni.leaklens.actions.ExportReportAction"
                text="Export Report" description="Export leak analysis as HTML/JSON/SARIF report"/>
            <action id="LeakLens.SaveBaseline" class="com.github.devvikassoni.leaklens.actions.SaveBaselineAction"
                text="Save as Baseline" description="Save current leaks as baseline (suppress in future analyses)"/>
        </group>
    </actions>
</idea-plugin>